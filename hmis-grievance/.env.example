# ---- Server ----
PORT=4200
NODE_ENV=development
CORS_ORIGIN=*

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Seeded admin (created on first run if no staff exist)
ADMIN_EMAIL=admin@mphmis.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=System Administrator

# ---- Storage ----
DB_FILE=./data/hmis-grievance.db

# ---- SLA auto-escalation ----
SLA_SWEEP_CRON=*/15 * * * *
