# ---- Server ----
PORT=4200
NODE_ENV=development
CORS_ORIGIN=*

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Seeded admin (created on first run if no staff exist)
ADMIN_EMAIL=admin@mphmis.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=System Administrator

# ---- Storage ----
DB_FILE=./data/hmis-grievance.db

# ---- Email (ticket auto-assignment notifications) ----
# When SMTP is not set, notifications are logged to the console instead of sent — the assignment
# flow still works. Configure SMTP to actually email the assigned developer.
EMAIL_ENABLED=false
EMAIL_FROM=HMIS Helpdesk <helpdesk@mphmis.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---- AI ("Rewrite with AI" on grievances) ----
# Local-first so patient text never leaves the server. provider: ollama | groq | none
AI_PROVIDER=ollama
AI_TIMEOUT_MS=30000
# Ollama (local). Install from https://ollama.com then: ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Groq (cloud) — only if AI_PROVIDER=groq. Text leaves the server; avoid for patient data.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
