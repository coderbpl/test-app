{
  "name": "hmis-grievance",
  "version": "1.0.0",
  "description": "MP HMIS — unified grievance handling, patient feedback, and internal ticketing. Local-only (no cloud): SLA auto-escalation, similarity-based ticket routing, feedback analytics.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/db/seed.js",
    "sla:sweep": "node src/jobs/slaSweep.js --once"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3"
  }
}
