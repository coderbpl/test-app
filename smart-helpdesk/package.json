{
  "name": "smart-helpdesk",
  "version": "1.0.0",
  "description": "Email-driven ticketing with similarity-based recommendations: auto-create tickets from email, auto-assign to the agent who resolved similar tickets, and draft replies from past resolutions (Groq).",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/db/seed.js",
    "poll:email": "node src/jobs/emailPoll.js --once"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "imapflow": "^1.0.164",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.7.1",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3"
  }
}
