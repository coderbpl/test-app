# ---- Server ----
PORT=4100
NODE_ENV=development
CORS_ORIGIN=*

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Seeded admin agent (created on first run if no agents exist)
ADMIN_EMAIL=admin@helpdesk.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Helpdesk Admin

# ---- Storage ----
DB_FILE=./data/helpdesk.db

# ---- AI (Groq) ----
# Groq is a CLOUD API (OpenAI-compatible). Ticket text sent for classification and reply-drafting
# leaves your server. The similar-ticket retrieval + agent routing runs LOCALLY and needs no key.
# Get a key at https://console.groq.com/keys
ENABLE_AI=true
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Any chat model your Groq account supports (see https://console.groq.com/docs/models)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=30000

# ---- Recommendations ----
# Minimum lexical similarity (0-1) for a past ticket to count toward auto-assignment.
SIMILARITY_THRESHOLD=0.12
# How many similar tickets to surface / vote with.
SIMILAR_TOP_K=5

# ---- Email ingestion (optional) ----
# Two ways in: (1) an inbound webhook POST /api/email/inbound (works out of the box, e.g. from
# SES/SendGrid inbound parse), and (2) IMAP polling of a real mailbox (below). Leave IMAP off for
# a quick start and use the webhook.
ENABLE_EMAIL_POLL=false
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
EMAIL_POLL_CRON=*/2 * * * *
